<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Custom theme tracking fallback fullscreen logic -->
    <style name="GameTheme" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <!-- Allows your GL surface area to render behind notch screen shapes -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- REMOVED: android:windowHideNavigation is not a real framework attribute -->
    </style>
</resources>
